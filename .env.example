# ─── Brevo Email SMTP & API ───────
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-smtp-login@brevo.com
BREVO_SMTP_PASS=your-smtp-password
BREVO_API_KEY=your-brevo-api-key
FROM_EMAIL=your-email@yourdomain.com
FROM_NAME=Artum 8 Labs
EMAIL_DAILY_LIMIT=300

# ─── IMAP Reply Detection ─────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password
REPLY_CHECK_MODE=imap
REPLY_POLL_INTERVAL=300000
WEBHOOK_PORT=3001

# ─── Payments & Checkout ──────────
# Custom Payment Link (Use this if you don't have Stripe yet, e.g. PayPal, Wise, Razorpay, or custom link)
CUSTOM_PAYMENT_LINK=https://buy.stripe.com/your-custom-link-or-paypal

# Stripe Payments (Optional - leave blank if using CUSTOM_PAYMENT_LINK)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://artum8labs.com/success
STRIPE_CANCEL_URL=https://artum8labs.com/cancel

# ─── Email Verification ──────────
# ZeroBounce (100 free/mo): https://www.zerobounce.net/
ZEROBOUNCE_API_KEY=
# Hunter (25 free/mo): https://hunter.io/
HUNTER_API_KEY=

# ─── Audit Widget ─────────────────
PORT=3001
CAL_LINK=https://cal.com/artum8labs
COMPANY_NAME=Artum 8 Labs

# ─── General ──────────────────────
APP_URL=http://localhost:3000
DB_PATH=./data/leads.db